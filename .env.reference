# =============================================================================
# lib-systemplane — Environment Variable Reference
# =============================================================================
#
# IMPORTANT: lib-systemplane reads ZERO environment variables directly.
# The constructors take explicit Go parameters and functional options:
#
#   systemplane.NewPostgres(db *sql.DB, listenDSN string, opts ...Option)
#   systemplane.NewMongoDB(client *mongo.Client, database string, opts ...Option)
#
# The names below are CONVENTIONS — recommended variable names for consuming
# services that build the systemplane client from environment configuration.
# They are NOT library-enforced reads. Nothing in this module calls os.Getenv
# or os.LookupEnv.
#
# Runtime-mutable keys registered via Register / RegisterTenantScoped are the
# DESTINATION for runtime values, not the SOURCE. They live in the systemplane
# store (Postgres table or MongoDB collection) and are reloaded on change. They
# do NOT appear in this file. See README.md and MIGRATION_TENANT_SCOPED.md for
# registered-key patterns.
#
# Evaluation order (at consumer service):
#   1. Explicit Go parameters to NewPostgres / NewMongoDB always win.
#   2. Functional options (WithTable, WithCollection, ...) override defaults.
#   3. Env vars below are a convention for sourcing those values at bootstrap.
#
# Generated: 2026-04-21
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND SELECTION
# -----------------------------------------------------------------------------
# Hint for consumer bootstrap code to decide which constructor to call.
# The library itself does not read this — it's a switch inside the consumer.
# Valid values: "postgres", "mongodb"
# Type: string
# Default: (none — consumer decides which constructor to call)
SYSTEMPLANE_BACKEND=

# -----------------------------------------------------------------------------
# POSTGRES BACKEND
# -----------------------------------------------------------------------------
# Required when SYSTEMPLANE_BACKEND=postgres.

# PostgreSQL data source name (connection string).
# Passed as listenDSN to systemplane.NewPostgres(db, listenDSN, opts...).
# Also used by the consumer to open the *sql.DB passed as the first argument.
# database/sql does not expose its underlying DSN, so the listen connection
# must be configured explicitly — typically the same DSN.
# Type: string (Postgres DSN)
# Default: (none — required when backend=postgres)
SYSTEMPLANE_POSTGRES_DSN=

# Table name for runtime configuration entries.
# Maps to: WithTable(name)
# Type: string
# Default: "systemplane_entries"
SYSTEMPLANE_POSTGRES_ENTRIES_TABLE=systemplane_entries

# PostgreSQL LISTEN/NOTIFY channel for real-time change notifications.
# Maps to: WithListenChannel(name)
# Using a non-default name suppresses the default-channel collision warning
# that otherwise fires when multiple services share "systemplane_changes".
# Type: string
# Default: "systemplane_changes"
SYSTEMPLANE_POSTGRES_NOTIFY_CHANNEL=systemplane_changes

# -----------------------------------------------------------------------------
# MONGODB BACKEND
# -----------------------------------------------------------------------------
# Required when SYSTEMPLANE_BACKEND=mongodb.

# MongoDB connection URI.
# Used by the consumer to build the *mongo.Client passed to
# systemplane.NewMongoDB(client, database, opts...).
# Type: string (MongoDB URI)
# Default: (none — required when backend=mongodb)
SYSTEMPLANE_MONGODB_URI=

# MongoDB database name for systemplane collections.
# Passed as the database argument to systemplane.NewMongoDB(client, database).
# Type: string
# Default: "systemplane"
SYSTEMPLANE_MONGODB_DATABASE=systemplane

# MongoDB collection for runtime configuration entries.
# Maps to: WithCollection(name)
# Type: string
# Default: "systemplane_entries"
SYSTEMPLANE_MONGODB_ENTRIES_COLLECTION=systemplane_entries

# Polling interval in seconds. A positive value switches MongoDB from
# change-streams mode to polling mode. Required (> 0) for standalone MongoDB
# deployments without a replica set, since change streams depend on the
# replica-set oplog. Zero (or unset) keeps change-streams mode.
# Maps to: WithPollInterval(d)
# Type: int (seconds)
# Default: 0 (change-streams mode)
SYSTEMPLANE_MONGODB_POLL_INTERVAL_SEC=0

# -----------------------------------------------------------------------------
# CLIENT OPTIONS
# -----------------------------------------------------------------------------

# Trailing-edge debounce window for change notifications, in milliseconds.
# Coalesces rapid updates to the same (namespace, key, tenantID) tuple into
# a single refresh. A zero or negative value disables debouncing.
# Rarely tuned in practice; change only if subscriber fan-out is causing
# changefeed pressure.
# Maps to: WithDebounce(d)
# Type: int (milliseconds)
# Default: 100
SYSTEMPLANE_DEBOUNCE_MS=100

# Maximum entries in the bounded-LRU tenant cache when lazy tenant hydration
# is enabled. A positive value switches tenant value caching from eager
# (load all tenant rows at Start) to lazy (miss-populate under a bounded LRU).
# Non-positive or unset falls back to eager mode.
# Best fit for deployments with a large tenant population where only a subset
# is routinely active (e.g. >10k tenants × N keys with ~100 active at a time).
# Trade-off: ~5-10ms first-touch cost per (tenant, key) tuple in exchange for
# bounded memory.
# Maps to: WithLazyTenantLoad(maxEntries)
# Type: int (entries)
# Default: (unset — eager hydration)
SYSTEMPLANE_LAZY_TENANT_LOAD_MAX=

# -----------------------------------------------------------------------------
# ADMIN HTTP SURFACE
# -----------------------------------------------------------------------------

# URL path prefix for admin routes mounted via admin.Mount(router, client, opts...).
# The admin surface registers six routes under this prefix: three legacy global
# routes and three tenant-scoped routes.
# Maps to: admin.WithPathPrefix(p)
# Type: string
# Default: "/system"
SYSTEMPLANE_ADMIN_PATH_PREFIX=/system

# Code-only admin options — NO env-var representation:
#
#   admin.WithAuthorizer(fn func(*fiber.Ctx, action string) error)
#     Required to enable the three legacy global routes. Absent = 403 on every
#     legacy route. Takes a function value; cannot be expressed as an env var.
#
#   admin.WithTenantAuthorizer(fn func(*fiber.Ctx, action, tenantID string) error)
#     Required to enable the three tenant-scoped routes. Absent = 403 on every
#     tenant route (default-deny). The library does NOT silently fall back to
#     WithAuthorizer for tenant routes — consumers must opt in explicitly to
#     avoid silent privilege escalation. Takes a function value.
#
#   admin.WithActorExtractor(fn func(*fiber.Ctx) string)
#     Customizes how the actor identity is extracted from a Fiber request for
#     audit logging on writes. Takes a function value.

# -----------------------------------------------------------------------------
# EXPLICIT NON-SCOPE — documented so consumers don't look for env vars here
# -----------------------------------------------------------------------------
#
# Registered runtime keys (namespace + key values registered via
# Register / RegisterTenantScoped) are NOT environment variables. They live
# in the systemplane store (Postgres table or MongoDB collection) and are
# mutated via Set / SetForTenant or the admin HTTP surface. See README.md
# and MIGRATION_TENANT_SCOPED.md for registered-key patterns.
#
# Logger injection (WithLogger) and telemetry injection (WithTelemetry) are
# code-only. They take typed Go values (log.Logger, *lib-observability/tracing.Telemetry)
# constructed at service bootstrap — no env-var representation.
#
# Per-key options — WithDescription (string), WithValidator (function value),
# WithRedaction (RedactPolicy constant) — are code-only and specified at each
# Register / RegisterTenantScoped call site.
#
# Phase-2 tenant schema (WithTenantSchemaEnabled) is code-only. Flip it only
# after every consumer process in the same database is on a tenant-aware
# release; see MIGRATION_TENANT_SCOPED.md §4 for the runbook.
#
# The tenant-scoped API adds NO new bootstrap env vars beyond those above —
# only runtime/per-tenant behavior, which is governed at the code level.
